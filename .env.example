# ============================================================
# Sach Check settings
# Copy this file to .env  (cp .env.example .env)  and fill it in.
# .env is in .gitignore, so your key never goes to GitHub.
# ============================================================

# ---- Claude (writes the casual "AI ki raye" reply) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---- Model API (Python). Only reachable inside the server. ----
# Pick a port that is free on your server (check with: sudo ss -tlnp)
API_HOST=127.0.0.1
API_PORT=5055

# ---- Verdict bands (chance of being fake) ----
FAKE_THRESHOLD=0.75
REAL_THRESHOLD=0.40

# ---- WhatsApp bot ----
# Country code used when you type a local number like 03001234567
DEFAULT_COUNTRY_CODE=92
# Join codes (most reliable): a person sends "join <code>" to the bot number once.
# JOIN_CODE makes them a user, ADMIN_CODE makes them an admin (can send !add, !list, !status...).
# Works even when WhatsApp hides their number. Pick your own secret words.
JOIN_CODE=
ADMIN_CODE=
# People allowed to use the bot, set here directly (comma separated). You can also add with !add.
ALLOWED_NUMBERS=
# Optional: other numbers that can send owner commands (!add, !list...) to the bot.
# Comma separated, e.g. 03001234567,03111234567. Leave empty if only you.
ADMIN_NUMBERS=
# A normal (not forwarded, no link) message is only checked if it has at least this many Urdu words.
# Forwarded messages and links are always checked. Keeps normal family chat from being "fact-checked".
MIN_WORDS_TO_CHECK=12
COOLDOWN_SECONDS=5
MAX_MESSAGE_AGE_MINUTES=10
# Only if Chrome fails to start: path to an installed Chrome/Chromium, e.g. /usr/bin/chromium
CHROME_PATH=

# Log one line per incoming message (no message text). 1 = on, 0 = off
DEBUG_MESSAGES=1
